    "opdsPluginIdSyncHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The OPDS catalog's ID is used to keep the plugin ID consistent across devices. If the catalog does not provide an ID, this plugin will use a local ID and its records will not sync."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "插件會使用OPDS目錄提供的ID，確保在不同裝置間保持一致。若目錄未提供ID，插件會使用僅限本機的ID，相關紀錄將不會同步。"
          }
        }
      }
