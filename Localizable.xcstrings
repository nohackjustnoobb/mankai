    "smartGrouping" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Grouping"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能分組"
          }
        }
      }
    },
    "smartGroupingDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart grouping uses deep learning to automatically organize pages based on content similarity. Results may vary, and enabling this feature could impact performance and battery life."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能分組利用深度學習技術，根據內容相似度自動對頁面進行分類。請注意，分組結果可能不盡完美，且可能會影響執行效能和電池續航力。"
          }
        }
      }
    },
    "smartGroupingSensitivity" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Grouping Sensitivity"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能分組敏感度"
          }
        }
      }
    },
    "smartGroupingSensitivityDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higher sensitivity will tend to group pages together and lower sensitivity will tend to split pages apart."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "數值越高，越容易將頁面分在一起。數值越低，越容易將頁面分開。"
          }
        }
      }
    },
